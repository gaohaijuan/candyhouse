; Engine configuration file.
config_version=5

[application]

config/name="甜点三连 · Sweet Triple"
run/main_scene="res://scenes/app.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/desserts/macaron.png"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"
window/handheld/orientation=1

[internationalization]

locale/fallback="zh"

[rendering]

environment/defaults/default_clear_color=Color(0.96, 0.84, 0.86, 1)

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
textures/vram_compression/import_etc2_astc=true
